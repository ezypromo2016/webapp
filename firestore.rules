rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Is the user signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ezypromo1991@gmail.com' ||
        request.auth.token.email == 'admin@pos.com' ||
        request.auth.token.email == 'admin@cbk.com'
      );
    }

    // 1. Business Info - Publicly readable so the app can show the business name/logo during boot
    match /business_info/{infoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Users - Users can read/write their own profiles
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // 3. POS Data - Allow all authenticated staff to read and create records
    match /transactions/{txnId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();

      match /items/{itemId} {
        allow read, create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    match /printing_records/{recordId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /printing_expenses/{expenseId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /gcash_transactions/{txnId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isSignedIn();
    }

    match /credits/{creditId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 4. Inventory - All staff can read, only admin can manage
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. Staff and Attendance
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance/{logId} {
      // Admins see everything, users see their own
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || request.resource.data.user_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 6. Customers
    match /customers/{customerId} {
      allow read, update: if isSignedIn();
      allow create, delete: if isAdmin();
    }

    match /sos_credits/{recordId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /order_expenses/{expenseId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /gcash_accounts/{accountId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /dafox_transactions/{txnId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Default Deny for anything else
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
